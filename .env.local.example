# Base URL of the docs-cloak backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: Sentry error tracking. Leave unset to disable entirely (local dev default).
# SENTRY_DSN is used server-side; NEXT_PUBLIC_SENTRY_DSN ships to the browser bundle,
# so it's fine for it to be the same DSN value (Sentry DSNs are not secret).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: mirrors the backend's MAX_UPLOAD_BYTES so oversized files are rejected
# client-side before uploading. Defaults to 25MB if unset.
# NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400
